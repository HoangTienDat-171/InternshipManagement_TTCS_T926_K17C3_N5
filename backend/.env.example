IMS_DATABASE_BACKEND=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
# Optional: set only when the launcher should start a local Windows MySQL service.
# The launcher validates the executable and configured port, and never guesses a service.
# MYSQL_SERVICE_NAME=MySQL80
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=internship_management

# US41: keep backup artifacts outside the repository and web-served folders.
# Defaults to %LOCALAPPDATA%\\IMS-Backups on Windows.
IMS_BACKUP_DIRECTORY=
IMS_MYSQLDUMP_BIN=
IMS_SCHEMA_VERSION=20261017_us38_us41_us42

# Optional Gmail SMTP delivery for the US08 email outbox (use a Google App Password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_SSL=false
SMTP_USE_STARTTLS=true
SMTP_TIMEOUT_SECONDS=15
EMAIL_WORKER_INTERVAL_SECONDS=5
IMS_DISABLE_EMAIL_WORKER=0
IMS_COMPANY_NAME=IMS Portal
IMS_PORTAL_URL=

# Local HRM Sandbox only. Leave HRM_PROVIDER blank when the sandbox is stopped.
HRM_PROVIDER=
HRM_SANDBOX_BASE_URL=http://127.0.0.1:8100
HRM_SANDBOX_API_KEY=
HRM_SANDBOX_ADMIN_API_KEY=
HRM_SANDBOX_TIMEOUT_SECONDS=5
HRM_SANDBOX_PORT=8100
# Enables the restricted IMS -> HRM candidate-draft workflow only for HRM_PROVIDER=sandbox and an isolated UAT database.
IMS_HRM_SANDBOX_OUTBOUND_ENABLED=0
# Optional: separate persistent SQLite file; never point this at the IMS database.
HRM_SANDBOX_DATABASE_PATH=
# Select mysql only for a dedicated local HRM Sandbox UAT schema; credentials are supplied by the local launcher.
HRM_SANDBOX_DATABASE_BACKEND=sqlite
HRM_SANDBOX_MYSQL_HOST=127.0.0.1
HRM_SANDBOX_MYSQL_PORT=3306
HRM_SANDBOX_MYSQL_USER=
HRM_SANDBOX_MYSQL_PASSWORD=
HRM_SANDBOX_MYSQL_DATABASE=hrm_us37_clean_uat
# Keep the Sandbox employee demo seed disabled for clean UAT.
HRM_SANDBOX_SEED_DEMO=0
